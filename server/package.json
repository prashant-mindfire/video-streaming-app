{
  "name": "server",
  "version": "1.0.0",
  "description": "video streaming server app",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "tsx --env-file=../.env src/index.ts",
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start:docker": "tsx src/index.ts",
    "dev:docker": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "prod": "node dist/index.js",
    "dev:outbox": "tsx watch --env-file=../.env src/workers/outbox-runner.ts",
    "dev:worker": "tsx watch --env-file=../.env src/workers/video.worker.ts",
    "start:outbox": "node dist/workers/outbox-runner.js",
    "start:worker": "node dist/workers/video.worker.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "amqplib": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
