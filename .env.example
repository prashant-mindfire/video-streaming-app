# Node Environment
NODE_ENV=development

# Server configuration
PORT=5000
DATABASE_URL=postgresql://admin:change-me@localhost:5432/video_streaming_app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000
API_VERSION=v1
JWT_SECRET=change-me-to-a-long-random-secret

# Client configuration
VITE_PORT=3001
VITE_API_URL=http://localhost:5000/api/v1

# PostgreSQL configuration
DB_USER=admin
DB_PASSWORD=change-me
DB_NAME=video_streaming_app

# RustFS configuration
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change-me
RUSTFS_STORAGE_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET_NAME=video-streaming-bucket

# Redis configuration
REDIS_URL=redis://localhost:6379

# RabbitMQ configuration
RABBITMQ_URL=amqp://admin:change-me@localhost:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me
